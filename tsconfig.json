{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig.json to read more about this file */
    "target": "es6",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["./*.ts", "__tests__/**/*.ts", "__tests__/**/*.d.ts", "src/**/*.ts", "src/**/*.d.ts"]
}
