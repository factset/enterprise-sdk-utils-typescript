{
  "name": "@factset/sdk-utils",
  "description": "Utilities for interacting with FactSet APIs.",
  "version": "3.0.0",
  "homepage": "https://developer.factset.com",
  "repository": "FactSet/enterprise-sdk-utils-typescript.git",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "FactSet Research Systems",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://developer.factset.com"
  },
  "keywords": [
    "FactSet",
    "API",
    "SDK"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "lint": "yarn prettier:check && yarn eslint:check",
    "lint:fix": "yarn prettier:fix && yarn eslint:fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "eslint:check": "eslint src",
    "eslint:fix": "eslint --fix src",
    "test": "vitest run --coverage",
    "prepublishOnly": "yarn build"
  },
  "files": [
    "dist",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "debug": "^4.4.3",
    "jose": "^6.2.13",
    "openid-client": "^6.8.8",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.0"
}
